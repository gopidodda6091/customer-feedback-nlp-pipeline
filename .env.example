# Copy to .env and adjust. No secrets are needed for this project.
# 1 = use sentence-transformers all-MiniLM-L6-v2; 0 = deterministic HashingEmbedder (default)
USE_ST_MODEL=0
# spark (default) or pandas (no JVM needed)
ENRICH_ENGINE=spark
SPARK_MASTER=local[2]
# Local MLflow file store
MLFLOW_TRACKING_URI=file:./mlruns
# Spark 3.5 needs Java 17
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
